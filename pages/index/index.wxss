/* pages/index/index.wxss - AI热点自动发布系统首页 */

/* 页面容器 */
.page-container {
  background: #F8F9FA;
  min-height: 100vh;
  padding-bottom: 160rpx;
  position: relative;
}

/* === 顶部区域 === */
.header-section {
  background: linear-gradient(135deg, #9333EA 0%, #EC4899 100%);
  padding: 40rpx 32rpx 32rpx;
  border-radius: 0 0 40rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(147, 51, 234, 0.2);
}

.header-content {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
}

.header-actions {
  display: flex;
  gap: 12rpx;
  align-items: center;
  position: relative;
  z-index: 10;
}

.app-icon-text {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 900;
  color: #fff;
}

.header-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.app-title {
  font-size: 38rpx;
  font-weight: bold;
  color: white;
  line-height: 1.2;
}

.app-subtitle {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.2;
  margin-top: 4rpx;
}

/* 积分显示 */
.credits-display {
  display: flex;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 16rpx;
  border-radius: 30rpx;
}

.credits-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.credits-icon-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 700;
}

.credits-value {
  font-size: 26rpx;
  color: white;
  font-weight: 700;
}

.icon-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon {
  font-size: 32rpx;
  color: white;
  font-weight: bold;
}

/* === 健康打卡条 === */
.health-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 20rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(245, 158, 11, 0.15);
}

.health-bar:active {
  transform: scale(0.98);
}

.health-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.health-icon-box {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.3);
}

.health-icon-box.checked {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.3);
}

.health-icon-text {
  font-size: 24rpx;
  font-weight: 900;
  color: white;
}

.health-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.health-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #92400E;
}

.health-sub {
  font-size: 20rpx;
  color: #B45309;
}

.health-detail-text {
  font-size: 22rpx;
  color: #92400E;
  font-weight: 600;
}

/* === 主要创作区域 === */
.main-section {
  margin: 24rpx 20rpx;
}

.input-box {
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.input-textarea {
  width: 100%;
  min-height: 100rpx;
  max-height: 300rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #1F2937;
  padding: 16rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
  border: 2rpx solid #E5E7EB;
}

.input-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.char-count {
  font-size: 22rpx;
  color: #9CA3AF;
}

.create-btn {
  background: linear-gradient(135deg, #9333EA 0%, #EC4899 100%);
  color: #FFFFFF !important;
  border: none;
  border-radius: 24rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(147, 51, 234, 0.3);
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
}

.create-btn[disabled] {
  opacity: 0.7;
  background: #CBD5E1;
  color: #9CA3AF !important;
  box-shadow: none;
}

.create-btn::after {
  border: none;
}

/* === 快捷功能 === */
.quick-functions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 16rpx;
}

.function-btn {
  background: white;
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.function-btn:active {
  transform: scale(0.95);
}

.function-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.btn-icon-text {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 800;
  color: #6B7280;
  background: #F3F4F6;
}

.function-btn.primary .btn-icon-text {
  background: rgba(255, 255, 255, 0.25);
  color: white;
}

.function-btn.primary .btn-text {
  color: white;
  font-weight: bold;
}

.btn-text {
  font-size: 22rpx;
  color: #6B7280;
  text-align: center;
}

/* === 灵感区域 === */
.inspiration-section {
  margin: 24rpx 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title-group {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.header-actions {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.refresh-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.refresh-icon {
  font-size: 24rpx;
  color: #6B7280;
  font-weight: bold;
}

.refresh-text {
  font-size: 22rpx;
  color: #6B7280;
}

.view-all-btn {
  font-size: 22rpx;
  color: #9333EA;
  font-weight: 600;
}

/* 分类标签 */
.category-tabs {
  display: flex;
  white-space: nowrap;
  margin-bottom: 16rpx;
  padding: 8rpx 0;
  gap: 12rpx;
}

.category-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 28rpx;
  background: white;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #6B7280;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  min-width: 100rpx;
  text-align: center;
}

.category-tab.active {
  background: linear-gradient(135deg, #9333EA 0%, #EC4899 100%);
  color: white;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(147, 51, 234, 0.3);
}

/* 热点列表 */
.hotspot-list {
  min-height: 200rpx;
}

.hotspot-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 8rpx 0;
}

.hotspot-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.hotspot-card:active {
  transform: scale(0.98);
}

.hotspot-rank {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #9333EA 0%, #EC4899 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: bold;
}

.hotspot-content {
  flex: 1;
  min-width: 0;
}

.hotspot-card .hotspot-title {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.hotspot-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.source-tag {
  font-size: 22rpx;
  color: #6B7280;
  background: #F3F4F6;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.heat-value {
  font-size: 22rpx;
  color: #EF4444;
  font-weight: 600;
}

.view-more-section {
  margin-top: 24rpx;
  text-align: center;
}

.view-more-btn {
  background: linear-gradient(135deg, #9333EA 0%, #EC4899 100%);
  color: white;
  border: none;
  border-radius: 28rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(147, 51, 234, 0.3);
}

.view-more-btn::after {
  border: none;
}

/* 加载状态 */
.loading-hotspot {
  text-align: center;
  padding: 60rpx 0;
}

.loading-text {
  font-size: 24rpx;
  color: #9CA3AF;
}

/* 创意建议 */
.suggestion-section {
  margin-top: 32rpx;
}

.suggestion-header {
  margin-bottom: 16rpx;
}

.suggestion-scroll {
  display: flex;
  white-space: nowrap;
  overflow-x: auto;
  gap: 12rpx;
  padding: 8rpx 0;
}

.suggestion-card {
  display: inline-block;
  min-width: 260rpx;
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.suggestion-content {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.suggestion-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1F2937;
}

.suggestion-desc {
  font-size: 20rpx;
  color: #6B7280;
  line-height: 1.4;
}

.suggestion-tags {
  display: flex;
  gap: 6rpx;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.tag {
  font-size: 18rpx;
  color: #9333EA;
  background: #F3E8FF;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

/* === 抽屉 === */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 99999;
}

.drawer-content {
  position: fixed;
  right: -100%;
  top: 0;
  bottom: 0;
  width: 80%;
  max-width: 600rpx;
  background: white;
  z-index: 100000;
  transition: right 0.3s ease;
  display: flex;
  flex-direction: column;
}

.drawer-content.show {
  right: 0;
}

.drawer-header {
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid #E5E7EB;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.drawer-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1F2937;
}

.drawer-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #6B7280;
  font-weight: bold;
}

.drawer-body {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx;
}

.drawer-group {
  margin-bottom: 32rpx;
}

.group-title {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.drawer-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  background: #F9FAFB;
}

.drawer-item:active {
  background: #F3F4F6;
}

.item-icon-box {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #9333EA 0%, #EC4899 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.item-icon-text {
  font-size: 18rpx;
  font-weight: 800;
  color: white;
}

.item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
}

.item-desc {
  font-size: 22rpx;
  color: #6B7280;
}
