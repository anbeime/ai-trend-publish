/* pages/api-config/api-config.wxss */
page {
  background-color: #F8F9FA;
  min-height: 100vh;
}

.container {
  min-height: 100vh;
  background-color: #F8F9FA;
  padding-bottom: 120rpx;
}

/* ========== 顶部状态概览 ========== */
.status-overview {
  padding: 24rpx 20rpx;
}

.status-card {
  background: white;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.status-card.active {
  border-left: 8rpx solid #52c41a;
}

.status-card.inactive {
  border-left: 8rpx solid #ff4d4f;
}

.status-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.status-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.status-badge {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.badge-on {
  background: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #b7eb8f;
}

.badge-off {
  background: #fff2f0;
  color: #ff4d4f;
  border: 1rpx solid #ffccc7;
}

.status-card-value {
  font-size: 24rpx;
  color: #666;
  word-break: break-all;
}

/* ========== 标签页 ========== */
.tab-bar {
  display: flex;
  background: white;
  padding: 0 12rpx;
  border-bottom: 1rpx solid #e9ecef;
  position: sticky;
  top: 0;
  z-index: 100;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #999;
  border-bottom: 4rpx solid transparent;
  transition: all 0.2s;
}

.tab-item.active {
  color: #9333EA;
  font-weight: 600;
  border-bottom-color: #9333EA;
}

/* ========== 配置区域 ========== */
.tab-content {
  padding: 20rpx;
}

.config-section {
  background: white;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.section-header {
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.section-desc {
  font-size: 24rpx;
  color: #999;
}

/* ========== 表单组件 ========== */
.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 26rpx;
  color: #495057;
  font-weight: 500;
  display: block;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #f8f9fa;
  border: 1rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-hint {
  font-size: 22rpx;
  color: #adb5bd;
  display: block;
  margin-top: 8rpx;
  line-height: 1.5;
}

.input-with-button {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.flex-input {
  flex: 1;
}

.toggle-eye {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #666;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-group.half {
  flex: 1;
}

/* ========== 开关行 ========== */
.switch-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.switch-label {
  font-size: 26rpx;
  color: #666;
}

/* ========== 模型选择列表 ========== */
.model-picker-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.model-item {
  background: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 24rpx;
  transition: all 0.2s;
}

.model-item.selected {
  background: #f5f0ff;
  border-color: #9333EA;
  box-shadow: 0 2rpx 12rpx rgba(147,51,234,0.15);
}

.model-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.model-item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.model-item.selected .model-item-name {
  color: #9333EA;
}

.model-tags {
  display: flex;
  gap: 8rpx;
}

.tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  line-height: 1.8;
}

.tag-free {
  background: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #b7eb8f;
}

.tag-recommend {
  background: #fff7e6;
  color: #fa8c16;
  border: 1rpx solid #ffd591;
}

.tag-multi {
  background: #e6f7ff;
  color: #1890ff;
  border: 1rpx solid #91d5ff;
}

.tag-gender {
  background: #f0f0f0;
  color: #666;
  border: 1rpx solid #d9d9d9;
}

.model-item-desc {
  font-size: 24rpx;
  color: #888;
  display: block;
  margin-bottom: 8rpx;
}

.model-meta {
  display: flex;
  gap: 24rpx;
}

.model-meta text {
  font-size: 22rpx;
  color: #adb5bd;
}

/* ========== 音色选择列表 ========== */
.voice-picker-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.voice-item {
  background: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 24rpx;
  transition: all 0.2s;
}

.voice-item.selected {
  background: #f5f0ff;
  border-color: #9333EA;
}

.voice-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.voice-item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.voice-item.selected .voice-item-name {
  color: #9333EA;
}

.voice-item-desc {
  font-size: 24rpx;
  color: #888;
}

/* ========== 按钮区 ========== */
.form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.btn-save {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: #9333EA;
  color: white;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.btn-save[disabled] {
  background: #ccc;
}

.btn-test {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: white;
  color: #9333EA;
  border: 2rpx solid #9333EA;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
}

/* ========== 测试结果 ========== */
.test-result {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.test-result.result-ok {
  background: #f6ffed;
  border: 1rpx solid #b7eb8f;
}

.test-result.result-fail {
  background: #fff2f0;
  border: 1rpx solid #ffccc7;
}

.result-label {
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.result-ok .result-label {
  color: #52c41a;
}

.result-fail .result-label {
  color: #ff4d4f;
}

.result-detail {
  font-size: 24rpx;
  color: #666;
  word-break: break-all;
}

/* ========== 底部操作 ========== */
.bottom-actions {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 20rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 100;
}

.btn-export {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  background: #f8f9fa;
  color: #333;
  border: 1rpx solid #d9d9d9;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.btn-reset {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  background: #fff2f0;
  color: #ff4d4f;
  border: 1rpx solid #ffccc7;
  border-radius: 12rpx;
  font-size: 26rpx;
}
