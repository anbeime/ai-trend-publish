<!--pages/index/index.wxml - AI热点自动发布系统首页-->
<view class="page-container">
  <!-- 顶部区域 -->
  <view class="header-section">
    <view class="header-content">
      <view class="app-icon-text">AI</view>
      <view class="header-text">
        <text class="app-title">AI热点自动发布系统</text>
        <text class="app-subtitle">热点采集 智能改写 多平台发布</text>
      </view>
    </view>
    <view class="header-actions">
      <view class="credits-display" wx:if="{{userCredits}}" bindtap="showCreditsDetail">
        <view class="credits-item">
          <text class="credits-icon-text">CR</text>
          <text class="credits-value">{{userCredits.dailyQuota - userCredits.dailyUsed}}/{{userCredits.dailyQuota}}</text>
        </view>
      </view>
      <view class="icon-btn" bindtap="openMoreDrawer">
        <text class="icon">=</text>
      </view>
    </view>
  </view>

  <!-- 健康打卡条（轻量游戏化入口） -->
  <view class="health-bar" bindtap="doHealthCheck">
    <view class="health-left">
      <view class="health-icon-box {{todayChecked ? 'checked' : ''}}">
        <text class="health-icon-text">{{todayChecked ? 'OK' : '+'}}</text>
      </view>
      <view class="health-info">
        <text class="health-title">{{todayChecked ? '今日已打卡' : '健康打卡'}}</text>
        <text class="health-sub">活力值 {{healthPoints}}  连击 {{healthStreak}}天</text>
      </view>
    </view>
    <view class="health-detail" catchtap="goToHealth">
      <text class="health-detail-text">详情 ></text>
    </view>
  </view>

  <!-- 主要创作区域 -->
  <view class="main-section">
    <view class="input-box">
      <textarea 
        class="input-textarea" 
        placeholder="输入你的创意，AI智能体将协同创作" 
        value="{{inputValue}}" 
        bindinput="onInputChange"
        maxlength="5000"
        auto-height
      ></textarea>
      <view class="input-footer">
        <text class="char-count">{{inputValue.length}}/5000</text>
        <button class="create-btn" bindtap="handleCreateClick" disabled="{{!inputValue}}">
          开始创作
        </button>
      </view>
    </view>

    <!-- 快捷功能 -->
    <view class="quick-functions">
      <view class="function-btn primary" bindtap="openContentCreator">
        <text class="btn-icon-text">WRITE</text>
        <text class="btn-text">内容创作</text>
      </view>
      <view class="function-btn primary" bindtap="handlePublishClick">
        <text class="btn-icon-text">SEND</text>
        <text class="btn-text">公众号发布</text>
      </view>
      <view class="function-btn" bindtap="handleAgentsClick">
        <text class="btn-icon-text">VIDEO</text>
        <text class="btn-text">视频创作</text>
      </view>
      <view class="function-btn" bindtap="handleProjectClick">
        <text class="btn-icon-text">FILE</text>
        <text class="btn-text">我的项目</text>
      </view>
    </view>
  </view>

  <!-- 创作灵感（热点） -->
  <view class="inspiration-section">
    <view class="section-header">
      <view class="section-title-group">
        <text class="section-title">创作灵感</text>
        <text class="section-subtitle">实时热点 创意建议</text>
      </view>
      <view class="header-actions">
        <view class="refresh-btn" bindtap="refreshHotspots">
          <text class="refresh-icon">{{loadingHotspots ? '...' : 'O'}}</text>
          <text class="refresh-text">{{loadingHotspots ? '加载中' : '刷新'}}</text>
        </view>
        <view class="view-all-btn" bindtap="openHotspotPage">
          <text>查看全部 ></text>
        </view>
      </view>
    </view>

    <!-- 分类标签 -->
    <scroll-view class="category-tabs" scroll-x enable-flex>
      <view class="category-tab {{selectedCategory === 'all' ? 'active' : ''}}" bindtap="selectCategory" data-category="all">
        <text>全部</text>
      </view>
      <view class="category-tab {{selectedCategory === 'tech' ? 'active' : ''}}" bindtap="selectCategory" data-category="tech">
        <text>科技</text>
      </view>
      <view class="category-tab {{selectedCategory === 'life' ? 'active' : ''}}" bindtap="selectCategory" data-category="life">
        <text>生活</text>
      </view>
      <view class="category-tab {{selectedCategory === 'entertainment' ? 'active' : ''}}" bindtap="selectCategory" data-category="entertainment">
        <text>娱乐</text>
      </view>
      <view class="category-tab {{selectedCategory === 'food' ? 'active' : ''}}" bindtap="selectCategory" data-category="food">
        <text>美食</text>
      </view>
    </scroll-view>

    <!-- 热点列表 -->
    <view class="hotspot-list" wx:if="{{!loadingHotspots}}">
      <view class="hotspot-grid">
        <view
          class="hotspot-card"
          wx:for="{{displayedHotspots}}"
          wx:key="id"
          bindtap="goToContentCreatorWithHotspot"
          data-hotspot="{{item}}"
        >
          <view class="hotspot-rank">{{index + 1}}</view>
          <view class="hotspot-content">
            <text class="hotspot-title">{{item.title || item.name}}</text>
            <view class="hotspot-meta">
              <text class="source-tag">{{item.source}}</text>
              <text class="heat-value">HOT {{item.hotness || item.heat}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="view-more-section" wx:if="{{realtimeHotspots.length > maxDisplayCount}}">
        <button class="view-more-btn" bindtap="openHotspotPage">
          查看全部 {{realtimeHotspots.length}} 条热点 >
        </button>
      </view>
    </view>

    <view class="loading-hotspot" wx:if="{{loadingHotspots}}">
      <text class="loading-text">正在加载热点...</text>
    </view>

    <!-- 创意建议 -->
    <view class="suggestion-section" wx:if="{{suggestions && suggestions.length > 0}}">
      <view class="suggestion-header">
        <text class="suggestion-title">创意建议</text>
      </view>
      <scroll-view class="suggestion-scroll" scroll-x enable-flex>
        <view
          class="suggestion-card"
          wx:for="{{suggestions}}"
          wx:key="id"
          bindtap="applySuggestion"
          data-suggestion="{{item}}"
        >
          <view class="suggestion-content">
            <text class="suggestion-title">{{item.title}}</text>
            <text class="suggestion-desc">{{item.desc}}</text>
          </view>
          <view class="suggestion-tags">
            <text class="tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">#{{tag}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 更多功能抽屉 -->
  <view class="drawer-mask" wx:if="{{showMoreDrawer === true}}" bindtap="closeMoreDrawer"></view>
  <view class="drawer-content {{showMoreDrawer === true ? 'show' : ''}}">
    <view class="drawer-header">
      <text class="drawer-title">更多功能</text>
      <view class="drawer-close" bindtap="closeMoreDrawer">X</view>
    </view>
    <view class="drawer-body">
      <view class="drawer-group">
        <view class="group-title">健康激励</view>
        <view class="drawer-item" bindtap="goToHealth">
          <view class="item-icon-box" style="background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);">
            <text class="item-icon-text">RUN</text>
          </view>
          <view class="item-content">
            <text class="item-title">AI健康管家</text>
            <text class="item-desc">每日打卡、运动挑战、活力值</text>
          </view>
        </view>
      </view>

      <view class="drawer-group">
        <view class="group-title">内容工具</view>
        <view class="drawer-item" bindtap="openContentCreator">
          <view class="item-icon-box"><text class="item-icon-text">WRITE</text></view>
          <view class="item-content">
            <text class="item-title">内容创作</text>
            <text class="item-desc">热点改写、AI生成文章</text>
          </view>
        </view>
        <view class="drawer-item" bindtap="navigateToWechatAccounts">
          <view class="item-icon-box"><text class="item-icon-text">SEND</text></view>
          <view class="item-content">
            <text class="item-title">公众号管理</text>
            <text class="item-desc">配置公众号、一键发布</text>
          </view>
        </view>
        <view class="drawer-item" bindtap="navigateToAgentsFromDrawer">
          <view class="item-icon-box"><text class="item-icon-text">VIDEO</text></view>
          <view class="item-content">
            <text class="item-title">视频创作</text>
            <text class="item-desc">多智能体协同创作</text>
          </view>
        </view>
      </view>

      <view class="drawer-group">
        <view class="group-title">辅助工具</view>
        <view class="drawer-item" bindtap="navigateToCreationHistory">
          <view class="item-icon-box"><text class="item-icon-text">HIST</text></view>
          <view class="item-content">
            <text class="item-title">创作历史</text>
            <text class="item-desc">查看历史创作记录</text>
          </view>
        </view>
        <view class="drawer-item" bindtap="navigateToTemplatesFromDrawer">
          <view class="item-icon-box"><text class="item-icon-text">TMPL</text></view>
          <view class="item-content">
            <text class="item-title">模板库</text>
            <text class="item-desc">精选创作模板</text>
          </view>
        </view>
        <view class="drawer-item" bindtap="navigateToProjectFromDrawer">
          <view class="item-icon-box"><text class="item-icon-text">PROJ</text></view>
          <view class="item-content">
            <text class="item-title">我的项目</text>
            <text class="item-desc">查看历史项目</text>
          </view>
        </view>
      </view>

      <view class="drawer-group">
        <view class="group-title">设置</view>
        <view class="drawer-item" bindtap="navigateToAgentUIFromDrawer">
          <view class="item-icon-box"><text class="item-icon-text">CHAT</text></view>
          <view class="item-content">
            <text class="item-title">AI对话模式</text>
            <text class="item-desc">对话式创作体验</text>
          </view>
        </view>
        <view class="drawer-item" bindtap="navigateToParamsFromDrawer">
          <view class="item-icon-box"><text class="item-icon-text">PARAM</text></view>
          <view class="item-content">
            <text class="item-title">参数设置</text>
            <text class="item-desc">自定义创作参数</text>
          </view>
        </view>
        <view class="drawer-item" bindtap="navigateToApiConfigFromDrawer">
          <view class="item-icon-box"><text class="item-icon-text">API</text></view>
          <view class="item-content">
            <text class="item-title">API配置</text>
            <text class="item-desc">查看API状态</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
