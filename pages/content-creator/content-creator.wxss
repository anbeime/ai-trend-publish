/* pages/content-creator/content-creator.wxss */
.page-container {
  min-height: 100vh;
  background: #f8f9fc;
  padding-bottom: 40rpx;
}

/* 创建按钮 - 紧凑样式 */
.create-btn {
  background: linear-gradient(135deg, #9333EA 0%, #EC4899 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 40rpx;
  padding: 20rpx 50rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(147, 51, 234, 0.3);
  transition: all 0.3s ease;
  min-width: 200rpx;
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
}

.create-btn:active {
  transform: scale(0.98);
}

.create-btn[disabled] {
  opacity: 0.6;
  box-shadow: none;
  background: #E5E7EB;
  color: #9CA3AF !important;
  pointer-events: none;
}

/* ========== 热点卡片新样式 ========== */
/* 元信息 */
.hotspot-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.source-tag {
  font-size: 22rpx;
  color: var(--color-text-light);
  background: var(--color-purple-light);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.heat-value {
  font-size: 22rpx;
  color: var(--color-orange);
  font-weight: 600;
}

/* 时效性标签 */
.freshness-tag {
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
  font-weight: 500;
}

.freshness-tag.fresh {
  background: rgba(34, 197, 94, 0.15);
  color: #16a34a;
}

.freshness-tag.normal {
  background: rgba(234, 179, 8, 0.15);
  color: #ca8a04;
}

.freshness-tag.old {
  background: rgba(156, 163, 175, 0.15);
  color: #6b7280;
}

/* 选中状态图标 */
.select-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--color-primary-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
}

.select-icon .icon {
  font-size: 24rpx;
  color: var(--color-text-white);
  font-weight: bold;
}

/* 分类标签容器 */
.category-tabs {
  margin: 20rpx 0 30rpx;
  padding-bottom: 10rpx;
}

/* ========== 多平台排版优化样式 ========== */

/* 排版工具栏 */
.format-toolbar {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  margin: 20rpx 30rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.toolbar-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.toolbar-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tool-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  min-width: 120rpx;
  transition: all 0.3s;
}

.tool-btn:active {
  transform: scale(0.95);
}

.tool-btn.active {
  background: #667eea;
}

.tool-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.tool-text {
  font-size: 24rpx;
  color: #666;
}

.tool-btn.active .tool-text {
  color: #fff;
}

/* 排版选项面板 */
.format-options-panel {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.option-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.option-label {
  font-size: 28rpx;
  color: #333;
}

/* 模态框样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  background: #fff;
  border-radius: 24rpx;
  width: 90%;
  max-width: 700rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.quality-modal {
  max-height: 85vh;
}

.platform-modal {
  max-height: 90vh;
  width: 95%;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.action-btn {
  font-size: 24rpx;
  color: #667eea;
  padding: 10rpx 20rpx;
  background: rgba(102, 126, 234, 0.1);
  border-radius: 8rpx;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  padding: 0 10rpx;
}

.modal-body {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
}

.platform-body {
  padding: 20rpx;
}

/* 标题优化列表 */
.title-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.title-item {
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.title-item.selected {
  border-color: #667eea;
  background: rgba(102, 126, 234, 0.1);
}

.title-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.title-meta {
  display: flex;
  gap: 20rpx;
}

.title-style {
  font-size: 24rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.title-score {
  font-size: 24rpx;
  color: #52c41a;
  background: rgba(82, 196, 26, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* 质量分析样式 */
.quality-score-section {
  display: flex;
  align-items: center;
  gap: 40rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  margin-bottom: 30rpx;
}

.score-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.score-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
}

.score-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.score-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.score-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.score-item .score-label {
  font-size: 26rpx;
  color: #fff;
}

.score-status {
  font-size: 28rpx;
}

.score-status.good {
  color: #52c41a;
}

.score-status.warning {
  color: #faad14;
}

/* 区块样式 */
.section-block {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.structure-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.info-item {
  font-size: 26rpx;
  color: #666;
}

.suggestions {
  margin-top: 20rpx;
}

.suggestion-item {
  font-size: 26rpx;
  color: #fa8c16;
  padding: 16rpx;
  background: rgba(250, 140, 22, 0.1);
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

/* SEO建议 */
.seo-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.seo-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  border-left: 6rpx solid #ddd;
}

.seo-item.high {
  border-left-color: #ff4d4f;
}

.seo-item.medium {
  border-left-color: #faad14;
}

.seo-item.low {
  border-left-color: #52c41a;
}

.seo-type {
  font-size: 24rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

.seo-message {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 多平台预览 */
.platform-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
  overflow-x: auto;
  padding-bottom: 10rpx;
}

.platform-tab {
  padding: 16rpx 30rpx;
  background: #f5f7fa;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  white-space: nowrap;
  transition: all 0.3s;
}

.platform-tab.active {
  background: #667eea;
  color: #fff;
}

.platform-content {
  background: #f8f9fa;
  border-radius: 16rpx;
  overflow: hidden;
}

.platform-info-bar {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.platform-info-bar .info-item {
  font-size: 24rpx;
  color: #666;
  padding: 8rpx 16rpx;
  background: #f0f2f5;
  border-radius: 8rpx;
}

.platform-info-bar .info-item.valid {
  color: #52c41a;
  background: rgba(82, 196, 26, 0.1);
}

.platform-info-bar .info-item.warning {
  color: #ff4d4f;
  background: rgba(255, 77, 79, 0.1);
}

.content-preview-box {
  padding: 30rpx;
  max-height: 600rpx;
  overflow-y: auto;
}

.preview-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 优化按钮 */
.optimize-btn {
  font-size: 24rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

/* ========== 图片面板样式 ========== */

.image-panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 2000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.image-panel {
  background: #fff;
  width: 100%;
  max-height: 85vh;
  border-radius: 40rpx 40rpx 0 0;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #eee;
}

.panel-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.panel-close {
  font-size: 48rpx;
  color: #999;
  padding: 10rpx;
}

/* 模式切换 */
.mode-tabs {
  display: flex;
  padding: 20rpx 40rpx;
  gap: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.mode-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  transition: all 0.3s;
}

.mode-tab.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.mode-tab.active .tab-text {
  color: #fff;
}

.tab-icon {
  font-size: 32rpx;
}

.tab-text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

/* 智能建议 */
.suggestions-section {
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #eee;
}

.suggestions-section .section-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 20rpx;
  display: block;
}

.suggestions-list {
  white-space: nowrap;
}

.suggestion-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  border-radius: 16rpx;
  margin-right: 16rpx;
  border: 2rpx solid rgba(102, 126, 234, 0.2);
}

.chip-type {
  font-size: 22rpx;
  color: #667eea;
  margin-bottom: 8rpx;
}

.chip-keyword {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* 搜索区域 */
.search-section {
  padding: 30rpx 40rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.search-input-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.search-btn {
  width: 140rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* AI生成区域 */
.generate-section {
  padding: 30rpx 40rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.prompt-input-area {
  position: relative;
  margin-bottom: 20rpx;
}

.prompt-textarea {
  width: 100%;
  height: 160rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.char-count {
  position: absolute;
  bottom: 16rpx;
  right: 20rpx;
  font-size: 24rpx;
  color: #999;
}

.generate-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 30rpx;
  flex-wrap: wrap;
}

.generate-btn {
  flex: 1;
  min-width: 180rpx;
  height: 72rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
  display: flex;
  align-items: center;
  justify-content: center;
}

.generate-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

/* 图片列表 */
.images-scroll {
  flex: 1;
  max-height: 600rpx;
}

.images-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding: 20rpx 0;
}

.image-item {
  position: relative;
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  border: 4rpx solid transparent;
  transition: all 0.3s;
}

.image-item.selected {
  border-color: #667eea;
}

.image-thumb {
  width: 100%;
  height: 100%;
}

.image-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(102, 126, 234, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-icon {
  font-size: 48rpx;
  color: #fff;
}

.image-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.6);
  padding: 8rpx 12rpx;
  display: flex;
  justify-content: space-between;
}

.image-source,
.image-size,
.image-keyword {
  font-size: 20rpx;
  color: #fff;
}

/* 图片分类 */
.image-category {
  margin-bottom: 30rpx;
}

.category-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: block;
}

.cover-image-item {
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
}

.cover-image {
  width: 100%;
  height: 400rpx;
}

.image-actions {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  display: flex;
  gap: 16rpx;
}

.action-icon {
  width: 64rpx;
  height: 64rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

/* 空状态 */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 底部操作栏 */
.panel-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  border-top: 1rpx solid #eee;
  background: #fff;
}

.selected-count {
  font-size: 28rpx;
  color: #666;
}

.insert-btn {
  padding: 20rpx 50rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
}

/* JSON预览弹窗样式 */
.json-modal {
  max-height: 90vh;
  width: 95%;
}

.json-preview {
  padding: 20rpx;
}

.json-section {
  margin-bottom: 30rpx;
}

.json-label {
  font-size: 26rpx;
  color: #667eea;
  font-weight: 600;
  display: block;
  margin-bottom: 10rpx;
}

.json-value {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-all;
}

.json-value.url {
  font-size: 24rpx;
  color: #666;
  background: #f5f7fa;
  padding: 15rpx;
  border-radius: 8rpx;
}

.html-preview {
  border-top: 2rpx solid #eee;
  padding-top: 30rpx;
}

.html-content-box {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  max-height: 600rpx;
  overflow-y: auto;
}

.action-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

/* 原有样式继续... */

/* 顶部导航栏 - 统一紫粉渐变 */
.header-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 30rpx 30rpx;
  background: linear-gradient(135deg, #9333EA 0%, #EC4899 100%);
  box-shadow: 0 4rpx 20rpx rgba(147, 51, 234, 0.2);
  position: relative;
  z-index: 10;
  border-radius: 0 0 40rpx 40rpx;
}

.header-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f0f4ff;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.back-btn:active {
  transform: scale(0.95);
  background: #e6ecff;
}

.back-btn .icon {
  font-size: 40rpx;
  color: #5a7cff;
  font-weight: bold;
}

.header-text {
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-align: center;
  flex: 1;
  margin: 0 20rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.page-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.95);
  margin-top: 8rpx;
  text-align: center;
  font-weight: 400;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.credits-display {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #5a7cff 0%, #8ba3ff 100%);
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(90, 124, 255, 0.2);
}

.credits-icon {
  font-size: 32rpx;
  color: #ffffff;
}

.credits-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

/* 流程步骤指示器 */
.workflow-steps {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 30rpx;
  background: #ffffff;
  margin: 30rpx 30rpx 40rpx;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid rgba(147, 51, 234, 0.1);
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.step-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f8f9fc;
  color: #999999;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.step-item.active .step-icon {
  background: linear-gradient(135deg, #9333EA 0%, #EC4899 100%);
  color: #ffffff;
  transform: scale(1.05);
  box-shadow: 0 6rpx 20rpx rgba(147, 51, 234, 0.3);
}

.step-item.completed .step-icon {
  background: linear-gradient(135deg, #9333EA 0%, #EC4899 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(147, 51, 234, 0.3);
}

.step-label {
  font-size: 28rpx;
  color: #666666;
  font-weight: 500;
  margin-top: 12rpx;
  transition: all 0.3s ease;
}

.step-item.active .step-label {
  color: #5a7cff;
  font-weight: 700;
}

.step-line {
  width: 100rpx;
  height: 4rpx;
  background: #e0e0e0;
  margin: 0 24rpx;
  transition: all 0.3s ease;
  border-radius: 2rpx;
}

.step-line.active {
  background: linear-gradient(90deg, #5a7cff 0%, #8ba3ff 100%);
}

/* 步骤内容区域 */
.step-content {
  margin: 0 30rpx 40rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 40rpx;
  min-height: 600rpx;
  padding-bottom: 180rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid rgba(147, 51, 234, 0.05);
}

/* 区块标题 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(135deg, #5a7cff 0%, #8ba3ff 100%);
  border-radius: 4rpx;
}

.refresh-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
}

.refresh-icon {
  font-size: 28rpx;
}

/* 分类标签 */
.category-tabs {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
  white-space: nowrap;
  padding: 8rpx 0;
}

.category-tab {
  padding: 20rpx 36rpx;
  background: #f8f9fc;
  border-radius: 40rpx;
  font-size: var(--font-size-md);
  color: var(--color-text-medium);
  font-weight: 500;
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
  flex-shrink: 0;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}

.category-tab.active {
  background: var(--color-primary-gradient);
  color: var(--color-text-white);
  font-weight: 600;
  box-shadow: var(--shadow-primary);
}

/* 热点列表 */
.hotspot-list {
  max-height: 60vh;
  min-height: 400rpx;
  padding: 10rpx 0;
}

.hotspot-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  transition: all 0.3s ease;
  position: relative;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid transparent;
}

.hotspot-card:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
}

.hotspot-card.selected {
  background: linear-gradient(135deg, rgba(147, 51, 234, 0.08) 0%, rgba(236, 72, 153, 0.08) 100%);
  border: 2rpx solid #9333EA;
  box-shadow: 0 8rpx 28rpx rgba(147, 51, 234, 0.15);
}

.circle-number {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.circle-number.orange {
  background: linear-gradient(135deg, #9333EA 0%, #EC4899 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(147, 51, 234, 0.3);
}

.circle-number.gray {
  background: #f0f0f0;
  color: #999999;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.hotspot-content {
  flex: 1;
  min-width: 0;
}

.hotspot-title {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.hotspot-meta {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.source-tag {
  font-size: 22rpx;
  color: #666666;
  padding: 4rpx 12rpx;
  background: #f0f4ff;
  border-radius: 10rpx;
  font-weight: 500;
}

.heat-value {
  font-size: 22rpx;
  color: #F97316;
  font-weight: 600;
}

.select-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #9333EA 0%, #EC4899 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.select-icon .icon {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: bold;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 20rpx;
}

.loading-icon {
  font-size: 60rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 步骤操作按钮 */
.step-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 60rpx;
  padding: 0 10rpx;
}

/* 步骤1的固定底部按钮 */
.step1-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  margin: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
  display: flex;
  gap: 20rpx;
}

.next-btn,
.generate-btn,
.publish-btn {
  flex: 1;
  height: 100rpx;
  background: linear-gradient(135deg, #5a7cff 0%, #8ba3ff 100%);
  color: #ffffff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  overflow: hidden;
  transition: all 0.3s ease;
  box-shadow: 0 6rpx 20rpx rgba(90, 124, 255, 0.3);
  letter-spacing: 1rpx;
}

.next-btn:active,
.generate-btn:active,
.publish-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(90, 124, 255, 0.4);
}

.next-btn.disabled,
.generate-btn.disabled,
.publish-btn.disabled {
  background: #e0e0e0;
  color: #999999;
  box-shadow: none;
  transform: none;
}

.back-btn-secondary {
  width: 180rpx;
  height: 100rpx;
  background: #f8f9fc;
  color: #666666;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: 2rpx solid #e0e0e0;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn-secondary:active {
  background: #f0f0f0;
  transform: translateY(2rpx);
}

.save-btn {
  flex: 1;
  height: 100rpx;
  background: #ffffff;
  color: #5a7cff;
  border: 2rpx solid #5a7cff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  transition: all 0.3s ease;
}

.save-btn:active {
  background: #f0f4ff;
  transform: translateY(2rpx);
}

/* 步骤3的按钮布局优化 */
.step-actions-final {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 40rpx;
}

.main-actions {
  display: flex;
  gap: 20rpx;
}

/* 已选热点卡片 */
.selected-hotspot-card {
  background: linear-gradient(135deg, rgba(90, 124, 255, 0.08) 0%, rgba(139, 163, 255, 0.08) 100%);
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
  border: 2rpx solid rgba(90, 124, 255, 0.2);
  box-shadow: 0 4rpx 20rpx rgba(90, 124, 255, 0.1);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #667eea;
}

.change-btn {
  font-size: 24rpx;
  color: #667eea;
  padding: 8rpx 20rpx;
  background: rgba(102, 126, 234, 0.1);
  border-radius: 20rpx;
}

.card-content .hotspot-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.hotspot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  color: #667eea;
  padding: 6rpx 16rpx;
  background: rgba(102, 126, 234, 0.1);
  border-radius: 20rpx;
}

/* 创作类型选择 */
.creation-type-section {
  margin-bottom: 40rpx;
}

.creation-type-section .section-title {
  font-size: 32rpx;
  margin-bottom: 24rpx;
}

.type-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

.type-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 36rpx 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  border: 2rpx solid transparent;
}

.type-card.selected {
  background: linear-gradient(135deg, rgba(90, 124, 255, 0.08) 0%, rgba(139, 163, 255, 0.08) 100%);
  border: 2rpx solid #5a7cff;
  box-shadow: 0 6rpx 24rpx rgba(90, 124, 255, 0.15);
}

.type-icon {
  font-size: 48rpx;
}

.type-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.type-desc {
  font-size: 22rpx;
  color: #999;
}

/* 创作参数 */
.creation-params {
  margin-bottom: 30rpx;
}

.param-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.param-label-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.param-label {
  font-size: 28rpx;
  color: #333;
}

.platform-tip {
  font-size: 22rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #667eea;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999;
}

/* 平台特性展示 */
.platform-features {
  margin-top: 20rpx;
  padding: 20rpx;
  background: rgba(102, 126, 234, 0.05);
  border-radius: 12rpx;
  border-left: 4rpx solid #667eea;
}

.feature-item {
  display: inline-block;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.feature-tag {
  font-size: 22rpx;
  color: #667eea;
  padding: 6rpx 16rpx;
  background: rgba(102, 126, 234, 0.1);
  border-radius: 20rpx;
  border: 1rpx solid rgba(102, 126, 234, 0.2);
}

.platform-tip-text {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  margin-top: 12rpx;
}

/* 额外需求输入 */
.additional-input {
  margin-bottom: 30rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.input-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* AI图片生成设置 */
.ai-image-settings {
  margin: 30rpx 0;
  padding: 24rpx;
  background: linear-gradient(135deg, #f0f9ff 0%, #e6f7ff 100%);
  border-radius: 16rpx;
  border: 1px solid #91d5ff;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.setting-info {
  flex: 1;
}

.setting-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.setting-desc {
  font-size: 24rpx;
  color: #666;
}

/* 生成内容展示 */
.generated-content-section {
  margin-bottom: 30rpx;
}

/* 内容区块 */
.content-block {
  background: #f9f9f9;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.block-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.block-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.copy-btn {
  font-size: 24rpx;
  color: #667eea;
  padding: 8rpx 20rpx;
  background: rgba(102, 126, 234, 0.1);
  border-radius: 20rpx;
}

/* 标题展示 */
.title-display {
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.5;
}

/* 正文展示 */
.content-scroll {
  max-height: 600rpx;
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
}

.content-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 标签展示 */
.tags-display {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-item {
  font-size: 24rpx;
  color: #667eea;
  padding: 8rpx 20rpx;
  background: rgba(102, 126, 234, 0.1);
  border-radius: 20rpx;
  border: 1rpx solid rgba(102, 126, 234, 0.2);
}

/* 建议文本 */
.suggestion-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
}

/* 配图建议列表 */
.image-suggestions-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
}

.suggestion-item {
  display: flex;
  flex-direction: column;
  padding: 16rpx 20rpx;
  background: #f8f9fa;
  border-radius: 10rpx;
  border-left: 4rpx solid #667eea;
}

.suggestion-keyword {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.suggestion-reason {
  font-size: 24rpx;
  color: #888;
}

/* 操作链接 */
.action-link {
  font-size: 24rpx;
  color: #667eea;
  padding: 8rpx 16rpx;
}

/* 封面图预览 */
.cover-preview {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  background: #f5f7fa;
}

/* 封面容器 */
.cover-container {
  position: relative;
  display: inline-block;
  width: 100%;
}

.cover-type-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* 头部操作按钮组 */
.header-actions {
  display: flex;
  gap: 16rpx;
}

.header-actions .action-link {
  font-size: 24rpx;
}

/* 封面生成提示 */
.cover-generate-hint {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.hint-text {
  font-size: 26rpx;
  color: #888;
  flex: 1;
}

.mini-btn {
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 8rpx;
  border: none;
  line-height: 1.4;
}

.mini-btn.secondary {
  background: #f0f0f0;
  color: #666;
}

.mini-btn::after {
  border: none;
}

/* 图片滚动列表 */
.images-scroll {
  white-space: nowrap;
  margin-top: 16rpx;
}

.images-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 8rpx 0;
}

.image-item {
  position: relative;
  display: inline-block;
  width: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 4rpx solid transparent;
  transition: all 0.3s ease;
}

.image-item.selected {
  border-color: #667eea;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.4);
}

.image-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  background: #f5f7fa;
}

.image-actions {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  padding: 8rpx;
  background: rgba(0, 0, 0, 0.6);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.image-item:hover .image-actions,
.image-item.selected .image-actions {
  opacity: 1;
}

.img-action-btn {
  font-size: 20rpx;
  color: #fff;
  padding: 4rpx 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 6rpx;
}

/* 图片搜索栏 */
.search-images-bar {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  background: #f8f9fa;
  border-radius: 10rpx;
  font-size: 26rpx;
  border: 2rpx solid #eee;
}

.search-btn {
  height: 72rpx;
  padding: 0 28rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 26rpx;
  border-radius: 10rpx;
  line-height: 1;
  white-space: nowrap;
}

.search-btn::after {
  border: none;
}

/* 优化建议列表 */
.tips-list {
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
}

.tip-item {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  align-items: flex-start;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.tip-dot {
  font-size: 28rpx;
  color: #667eea;
  line-height: 1.6;
}

.tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 内容操作按钮 */
.content-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.action-btn-secondary {
  flex: 1;
  height: 80rpx;
  background: #f5f5f5;
  color: #666;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
}

.action-btn-primary {
  flex: 1;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

/* 内容优化 */
.optimization-section {
  margin-bottom: 30rpx;
}

.optimization-section .section-title {
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.optimization-options {
  display: flex;
  gap: 20rpx;
}

.opt-btn {
  flex: 1;
  height: 72rpx;
  background: #f9f9f9;
  color: #333;
  border-radius: 12rpx;
  font-size: 24rpx;
  border: none;
}

/* 发布平台 */
.publish-section {
  margin-bottom: 30rpx;
}

.publish-section .section-title {
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

/* 当前公众号提示 */
.current-account-tip {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(102, 126, 234, 0.3);
}

.current-account-tip .tip-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.current-account-tip .tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.current-account-tip .tip-change {
  font-size: 24rpx;
  color: #667eea;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  transition: all 0.3s;
}

.current-account-tip .tip-change:active {
  background: #667eea;
  color: #fff;
  transform: scale(0.95);
}

.platform-options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.platform-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx;
  background: #f9f9f9;
  border-radius: 16rpx;
  position: relative;
  transition: all 0.3s;
}

.platform-card.selected {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  border: 2rpx solid #667eea;
}

.platform-icon {
  font-size: 48rpx;
}

.platform-name {
  font-size: 24rpx;
  color: #333;
}

.check-icon {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #667eea;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

/* 全局加载遮罩 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  backdrop-filter: blur(5px);
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
  padding: 80rpx 60rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
  min-width: 400rpx;
}

.loading-spinner {
  width: 100rpx;
  height: 100rpx;
  border: 8rpx solid #f3f3f3;
  border-top: 8rpx solid #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-content .loading-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  text-align: center;
  line-height: 1.6;
  max-width: 400rpx;
}

/* 视图切换器 */
.view-switcher {
  display: flex;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  padding: 8rpx;
  gap: 8rpx;
  margin-bottom: 30rpx;
}

.switch-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.switch-btn.active {
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.switch-icon {
  font-size: 32rpx;
}

.switch-text {
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.7);
}

.switch-btn.active .switch-text {
  color: #667eea;
}

/* 平台标签 */
.platform-tabs {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0;
  margin-bottom: 30rpx;
  white-space: nowrap;
}

.platform-tab {
  flex-shrink: 0;
  padding: 16rpx 32rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 40rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  transition: all 0.3s ease;
}

.platform-tab.active {
  background: #fff;
  color: #667eea;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

/* 格式化内容区块 */
.formatted-content-block {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.formatted-text {
  font-size: 30rpx;
  line-height: 1.8;
  color: #333;
  white-space: pre-wrap;
  word-wrap: break-word;
}

/* 格式化视图 */
.formatted-view {
  animation: fadeIn 0.3s ease;
}

/* 原始内容视图 */
.original-view {
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 平台特性提示 */
.platform-features {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1), rgba(118, 75, 162, 0.1));
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.feature-tip {
  font-size: 28rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.9);
}

/* HTML预览区域 */
.html-preview-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.html-preview-scroll {
  max-height: 600rpx;
  overflow-y: auto;
}

.html-preview-content {
  font-size: 28rpx;
  line-height: 1.8;
  color: #333;
  background: #fafafa;
  padding: 20rpx;
  border-radius: 12rpx;
}

/* 复制按钮组 */
.copy-btns {
  display: flex;
  gap: 16rpx;
}

.copy-btn.html-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.copy-btn.html-btn:active {
  opacity: 0.8;
}


