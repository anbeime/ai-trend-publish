# ============================================================
# FreeSwitch 环境变量配置
# 
# 使用方法:
#   1. 复制此文件: cp .env.example .env
#   2. 填入实际 API Key
#   3. 启动: docker-compose up -d
# 
# 注意: .env 文件不要提交到 Git
# ============================================================

# ---------- 免费 LLM 提供商 (Built-in 模式) ----------
# Google Gemini (免费额度大)
GOOGLE_API_KEY=

# Groq (超快推理)
GROQ_API_KEY=

# NVIDIA NIM (minimax-m2.7 等模型)
NVIDIA_API_KEY=

# OpenRouter (聚合多个模型)
OPENROUTER_API_KEY=

# SiliconFlow (硅基流动，国内可用)
SILICONFLOW_API_KEY=

# SenseNova (商汤)
SENSENOVA_API_KEY=

# ---------- 国内 API 提供商 (从美国服务器访问) ----------
# MiniMax TokenPlanPlus
MINIMAX_API_KEY=sk-cp-F5g0Bs7vOzpUoEV-ftuYw74zGLNpwJM1zgQFRqaTmNn4JethcMy7QAq3UHzhh4X8rI6PvBVhXOfnPYEn92ssCdg75ImfKdeXLkVGRQKLwuWFRCWn4MjYvPw
MINIMAX_GROUP_ID=1924304491927048863

# 智谱 GLM
ZHIPU_API_KEY=4db0d99270664530b2ec62e4862f0f8e.STEfVsL3x4M4m7Jn

# ---------- Enterprise 模式 (计费/账户管理) ----------
# 启用企业模式 (0=关闭, 1=开启)
FREESWITCH_ENTERPRISE=0

# TOPGO 企业后端 (可选，启用 Enterprise 模式时需要)
TOPGO_API_URL=
TOPGO_API_KEY=

# ---------- 服务端口 ----------
# FreeSwitch Core API 端口
CORE_PORT=3071

# FreeSwitch Dashboard 端口
DASHBOARD_PORT=3072

# FreeSwitch Enterprise 端口
ENTERPRISE_PORT=3073
